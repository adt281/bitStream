<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="85dp"
    android:background="@color/miniPlayerColor"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:elevation="4dp">

    <!-- Album Cover -->
    <ImageView
        android:id="@+id/mini_player_cover"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:scaleType="centerCrop"
        android:src="@drawable/logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="10dp"
        app:layout_constraintVertical_bias="0.5"/>

    <!-- PlayerView -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/mini_player_controls"
        android:layout_width="0dp"
        android:layout_height="40dp"
        app:controller_layout_id="@layout/exo_minimal_controls"
        app:use_artwork="false"
        app:show_timeout="0"
        app:hide_on_touch="false"
        app:resize_mode="fit"
        app:show_shuffle_button="false"
        app:show_subtitle_button="false"
        app:show_vr_button="false"
        app:layout_constraintStart_toEndOf="@+id/mini_player_cover"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintBottom_toTopOf="@id/title_artist_container"

        android:layout_marginLeft="5dp"
        android:layout_marginTop="6dp"/>

    <!-- Title + Artist -->
    <LinearLayout
        android:id="@+id/title_artist_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/mini_player_controls"
        app:layout_constraintStart_toStartOf="@+id/mini_player_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        >

        <!-- Song Title -->
        <TextView
            android:id="@+id/mini_player_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Title"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="6dp"/>

        <!-- Artist Name -->
        <TextView
            android:id="@+id/mini_player_artist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:text="Artist"
            android:textSize="18sp"
            android:alpha="0.8"
            android:maxLines="1"
            android:ellipsize="end"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
